{
  "manifest_version": 3,
  "name": "Steam Price Watcher",
  "version": "1.0.5",
  "description": "Track Steam game prices and get notified the moment they drop to your target price.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": ["storage", "alarms", "notifications"],
  "host_permissions": ["https://store.steampowered.com/*"],

  "background": {
    "service_worker": "background.js",
    "scripts": ["translations.js", "background.js"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "steam-price-watcher@mohamedashref371.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
